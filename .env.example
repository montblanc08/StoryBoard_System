# ==============================================================================
# FrameForge OS - Environment Configuration Template
# All production business data stays on internal company network.
# ==============================================================================

# Core API & Server
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-this-ultra-secure-secret-key-for-jwt-in-production-2026

# Database (PostgreSQL 16+)
POSTGRES_USER=frameforge
POSTGRES_PASSWORD=frameforge_secure_pass
POSTGRES_DB=frameforge_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://frameforge:frameforge_secure_pass@localhost:5432/frameforge_db
DATABASE_SYNC_URL=postgresql://frameforge:frameforge_secure_pass@localhost:5432/frameforge_db

# Redis & Background Queue (RQ)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO Compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=frameforge-media
S3_REGION=us-east-1
S3_USE_SSL=false

# Frontend Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="FRAMEFORGE OS"
NEXT_PUBLIC_APP_VERSION="3.0.0"

# Initial Admin Credentials (for development seeding)
INITIAL_ADMIN_EMAIL=admin@company.internal
INITIAL_ADMIN_PASSWORD=FrameForge2026!Admin
INITIAL_ADMIN_NAME="系统超级管理员"
